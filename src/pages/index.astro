---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hello!</div>
    <div class="text-5xl font-bold">I'm Omar Carreón</div>
    <div class="text-3xl py-3 font-bold">Engineering Manager</div>
    <div class="py-2">
      <text class="text-lg">
        Based in Monterrey, México. I have 9+ years in software development and technical leadership, combining hands-on
execution with managing cross-functional teams. Experienced in developing high-performing teams, optimizing
engineering processes, and building scalable solutions that drive business impact in fast-paced environments.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://www.linkedin.com/in/omarcarreon/" target="_blank"> Let's connect!</a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="We Make It"
    img="/wmimx"
    desc="Web platform for social events: each guest gets a link to pick their table within an assigned timeslot—everything in one place."
    url="https://github.com/omarcarreon"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Ground Logistics Platform"
    img="/portal1.webp"
    desc="Web platform for ground logistics company: manage clients, generate quotations, and automate emails and manual workflows."
    url="https://github.com/omarcarreon"
  />

  <div id="contact">
    <div class="text-3xl w-full font-bold mb-5 mt-10">Get in Touch</div>
  </div>

  <div class="py-2">
    <text class="text-lg">
      I'm always interested in hearing about new opportunities and collaborations. 
      Feel free to reach out through <a href="https://www.linkedin.com/in/omarcarreon/" target="_blank" class="text-primary hover:underline">LinkedIn</a> 
      or connect with me on social media.
    </text>
  </div>
</BaseLayout>
